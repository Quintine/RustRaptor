# Cargo output, local tooling, review evidence and duplicate export archives.
/target/
/dist/
/.reference/
/.local/
/derived/
/.runtime-data-*
__pycache__/

# Decoded source-reference images are not shipped mod artwork.
/mods/*/art/source/

# The playable bundle is intentionally tracked: bin/, lib/, data/ and
# runtime-manifest.json. Authored mod images, sounds and music are tracked too.
