{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MusicDef",
  "type": "object",
  "required": [
    "file",
    "id",
    "name"
  ],
  "properties": {
    "file": {
      "description": "Package-local checked MUS score, played through original GENMIDI FM.",
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "looping": {
      "default": true,
      "type": "boolean"
    },
    "name": {
      "type": "string"
    }
  },
  "additionalProperties": false
}