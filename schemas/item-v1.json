{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ItemDef",
  "type": "object",
  "required": [
    "id",
    "name",
    "price"
  ],
  "properties": {
    "art": {
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/Art"
        },
        {
          "type": "null"
        }
      ]
    },
    "consumable": {
      "default": false,
      "type": "boolean"
    },
    "credits": {
      "default": 0,
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "id": {
      "type": "string"
    },
    "initial_count": {
      "default": 1,
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "legacy": {
      "default": null,
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    },
    "max_count": {
      "default": 1,
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "name": {
      "type": "string"
    },
    "price": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "script": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "shield": {
      "default": 0,
      "type": "integer",
      "format": "int32"
    },
    "special": {
      "default": false,
      "type": "boolean"
    },
    "weapon": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Art": {
      "type": "object",
      "required": [
        "logical_height",
        "logical_width"
      ],
      "properties": {
        "asset": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "frames": {
          "default": 1,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "hd_png": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "logical_height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "logical_width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "nearest": {
          "default": false,
          "type": "boolean"
        },
        "png": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}