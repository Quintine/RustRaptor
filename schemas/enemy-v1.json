{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EnemyDef",
  "type": "object",
  "required": [
    "id",
    "name"
  ],
  "properties": {
    "art": {
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/Art"
        },
        {
          "type": "null"
        }
      ]
    },
    "boss": {
      "default": false,
      "type": "boolean"
    },
    "cooldown": {
      "default": 10,
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "drop": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "ground": {
      "default": false,
      "type": "boolean"
    },
    "health": {
      "default": 100,
      "type": "integer",
      "format": "int32"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "path": {
      "default": [],
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "integer",
          "format": "int32"
        },
        "maxItems": 2,
        "minItems": 2
      }
    },
    "repeat": {
      "default": false,
      "type": "boolean"
    },
    "reward": {
      "default": 0,
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "script": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "speed": {
      "default": 2,
      "type": "integer",
      "format": "int32"
    },
    "weapon": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Art": {
      "type": "object",
      "required": [
        "logical_height",
        "logical_width"
      ],
      "properties": {
        "asset": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "frames": {
          "default": 1,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "hd_png": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "logical_height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "logical_width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "nearest": {
          "default": false,
          "type": "boolean"
        },
        "png": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}